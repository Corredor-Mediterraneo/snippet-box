{
  "name": "snippet-box",
  "version": "2.0.0",
  "description": "Snippet manager with Google Drive backup support",
  "main": "build/server.js",
  "scripts": {
    "clean": "rm -rf build client/build",
    "build:client": "cd client && npm run build",
    "build:server": "tsc",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "dev:client": "cd client && npm start",
    "dev:server": "nodemon src/server.ts",
    "dev": "npm-run-all -n --parallel dev:**",
    "init:client": "cd client && npm install",
    "init:server": "npm install",
    "init": "npm i && cd client && npm i",
    "backup:create": "node build/utils/backup/GoogleDriveBackup.js",
    "backup:list": "node build/utils/backup/GoogleDriveBackup.js list",
    "backup:restore": "node build/utils/backup/GoogleDriveBackup.js restore"
  },
  "keywords": [
    "snippet",
    "manager",
    "google-drive",
    "backup"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}